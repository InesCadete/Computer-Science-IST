    <bpmn:textAnnotation id="TextAnnotation_0pijrfq">
      <bpmn:text>Interessado desiste</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0rmj71n" associationDirection="None" sourceRef="Event_1jsckmc" targetRef="TextAnnotation_0pijrfq" />
    <bpmn:textAnnotation id="TextAnnotation_012o9t3">
      <bpmn:text>Na data referida no contrato</bpmn:text>
