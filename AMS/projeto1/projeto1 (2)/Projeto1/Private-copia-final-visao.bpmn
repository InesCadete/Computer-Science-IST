    <bpmn:textAnnotation id="TextAnnotation_03julj5">
      <bpmn:text>Cliente potencial apresenta um pedido de proposta</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0tpg1ew">
      <bpmn:text>Contrato é enviado ao cliente firmado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1v2ytt6" associationDirection="None" sourceRef="Event_03805r5" targetRef="TextAnnotation_0tpg1ew" />
    <bpmn:textAnnotation id="TextAnnotation_05bwkz3">
      <bpmn:text>Contrato necessita de melhorias</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_04vj7sr" associationDirection="None" sourceRef="Flow_0vqwat5" targetRef="TextAnnotation_05bwkz3" />
    <bpmn:textAnnotation id="TextAnnotation_1j1ojry">
      <bpmn:text>Pedido Recusado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zvu24o">
      <bpmn:text>Interessado não respondeu num intervalo de tempo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0dnp4hu">
      <bpmn:text>Resposta do interessado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16yjmpg">
      <bpmn:text>Plano tem novos requisitos para o BioBox</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17795b9">
      <bpmn:text>Pedir mais elementos ao interessado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1y5eo0v">
      <bpmn:text>Plano complementado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1jrmb1k">
      <bpmn:text>interessado alterou o pedido</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1j21gop">
      <bpmn:text>ECQ desaprova o plano</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09qv4d3">
      <bpmn:text>ECQ aprova o plano</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1c6urwh">
      <bpmn:text>Interessado não respondeu num intervalo de tempo</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1f8442p">
      <bpmn:text>Contrato é enviado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gxvryj">
      <bpmn:text>Interessado propôs alterações</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0mfgye3">
      <bpmn:text>Interessado devolve o contrato assinado</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0z8dq3a" associationDirection="None" sourceRef="Flow_17ka326" targetRef="TextAnnotation_16yjmpg" />
    <bpmn:association id="Association_0f24nid" associationDirection="None" sourceRef="Flow_1lokpbr" targetRef="TextAnnotation_09qv4d3" />
